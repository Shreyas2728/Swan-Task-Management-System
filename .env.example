# Environment variables template
# Copy this file to .env and adjust values if needed

# Database Connection String
# Local development uses SQLite:
DATABASE_URL="file:./dev.db"

# Production example (PostgreSQL):
# DATABASE_URL="postgresql://username:password@hostname:5432/swan_task_db?schema=public"

# JSON Web Token Secret
JWT_SECRET="replace_with_a_secure_random_string_in_production"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
